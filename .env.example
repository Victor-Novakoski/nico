CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=
CLOUDFLARE_WHISPER_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=

# Postgres no Neon (ou um Postgres local para testes)
DATABASE_URL=
