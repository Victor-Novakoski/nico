# Copie para .env (fora do git) e preencha. Nenhum valor real aqui.

# Provedores de IA em ordem de tentativa (decisão 006).
# No ar: groq,cloudflare,openrouter. Na máquina, para testes e evals: ollama.
AI_PROVIDERS=ollama
GROQ_API_KEY=
GROQ_MODEL=
GROQ_WHISPER_MODEL=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=
CLOUDFLARE_WHISPER_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=

# Chave que assina o cookie de sessão (obrigatória no ar). Gere com:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
NICO_SECRET_KEY=

# Postgres no Neon (ou um Postgres local para testes)
DATABASE_URL=

# Testes de banco (opcional). Sem esta variável, eles são pulados.
# Local: `docker compose up -d` e use postgresql://nico@localhost:5433/nico
# (banco descartável de teste, sem senha, só em 127.0.0.1).
NICO_TEST_DATABASE_URL=
